<!DOCTYPE html>
<html>
<head>
  <title>Login – ResumeCloud</title>
  <style>
    body {
      background: linear-gradient(135deg, #eef2ff, #f8fafc);
      font-family: "Segoe UI", sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .box {
      background: white;
      padding: 40px;
      border-radius: 14px;
      width: 400px;
      box-shadow: 0 20px 40px rgba(0,0,0,.1);
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
    }

    input {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
    }

    button {
      width: 100%;
      padding: 12px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
    }

    p {
      text-align: center;
      margin-top: 15px;
    }

    a {
      color: #2563eb;
      text-decoration: none;
    }
  </style>
</head>
<body>

<div class="box">
  <h2>Login</h2>

  <% if (typeof error !== "undefined") { %>
    <p style="color:red"><%= error %></p>
  <% } %>

  <form method="POST" action="/login">
    <input name="email" placeholder="Email" required>
    <input name="password" type="password" placeholder="Password" required>
    <button>Login</button>
  </form>

  <p>New user? <a href="/register">Create account</a></p>
</div>

</body>
</html>
