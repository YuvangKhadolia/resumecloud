<!DOCTYPE html>
<html>
<head>
  <title>ResumeCloud – Build Your Resume</title>
  <style>
    body {
      margin: 0;
      font-family: "Segoe UI", sans-serif;
      background: linear-gradient(135deg, #eef2ff, #f8fafc);
    }

    .hero {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .box {
      background: white;
      padding: 60px;
      border-radius: 16px;
      box-shadow: 0 30px 60px rgba(0,0,0,.1);
      text-align: center;
      width: 500px;
    }

    h1 {
      margin-bottom: 10px;
      color: #1e293b;
    }

    p {
      color: #475569;
      margin-bottom: 30px;
    }

    a {
      display: inline-block;
      padding: 14px 32px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-size: 16px;
    }

    a:hover {
      background: #1d4ed8;
    }
  </style>
</head>
<body>

<div class="hero">
  <div class="box">
    <h1>ResumeCloud</h1>
    <p>Create professional resumes. Download. Apply. Get hired.</p>
    <a href="/login">Start Building</a>
  </div>
</div>

</body>
</html>
