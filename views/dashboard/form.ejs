<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Build Your Resume</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f1f5f9;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #0f172a;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px 50px;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            margin-bottom: 8px;
            font-size: 32px;
        }

        .header p {
            margin: 0;
            color: #64748b;
        }

        .form-card {
            background: white;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .07);
        }

        .section {
            margin-bottom: 30px;
        }

        .section h2 {
            font-size: 18px;
            color: #1e40af;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 8px;
            margin-bottom: 18px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .field {
            margin-bottom: 15px;
        }

        .field.full {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
        }

        input,
        textarea {
            width: 100%;
            padding: 12px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        input:focus,
        textarea:focus {
            border-color: #2563eb;
        }

        textarea {
            min-height: 110px;
            resize: vertical;
        }

        .hint {
            margin-top: 5px;
            font-size: 12px;
            color: #64748b;
        }

        .save-btn {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 7px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .save-btn:hover {
            background: #1d4ed8;
        }

        @media (max-width: 650px) {
            .container {
                margin: 20px auto;
            }

            .form-card {
                padding: 22px;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .field.full {
                grid-column: auto;
            }
        }
    </style>
</head>


<body>

<div class="container">

    <div class="header">

        <h1>Build Your Resume</h1>

        <p>
            Add your information to create a professional resume
        </p>

    </div>


    <div class="form-card">

        <form action="/resume/save" method="POST">


            <!-- PERSONAL INFORMATION -->

            <div class="section">

                <h2>Personal Information</h2>

                <div class="grid">

                    <div class="field">

                        <label>Full Name *</label>

                        <input
                            type="text"
                            name="name"
                            placeholder="Yuvang Khadolia"
                            value="<%= resume ? resume.name : '' %>"
                            required
                        >

                    </div>


                    <div class="field">

                        <label>Professional Title</label>

                        <input
                            type="text"
                            name="role"
                            placeholder="Software Engineer"
                            value="<%= resume ? resume.role : '' %>"
                        >

                    </div>


                    <div class="field">

                        <label>Email</label>

                        <input
                            type="email"
                            name="email"
                            placeholder="you@example.com"
                            value="<%= resume ? resume.email : '' %>"
                        >

                    </div>


                    <div class="field">

                        <label>Phone</label>

                        <input
                            type="text"
                            name="phone"
                            placeholder="+91 98765 43210"
                            value="<%= resume ? resume.phone : '' %>"
                        >

                    </div>


                    <div class="field full">

                        <label>Location</label>

                        <input
                            type="text"
                            name="location"
                            placeholder="Jaipur, Rajasthan, India"
                            value="<%= resume ? resume.location : '' %>"
                        >

                    </div>

                </div>

            </div>


            <!-- PROFESSIONAL LINKS -->

            <div class="section">

                <h2>Professional Links</h2>

                <div class="grid">

                    <div class="field">

                        <label>GitHub</label>

                        <input
                            type="url"
                            name="github"
                            placeholder="https://github.com/username"
                            value="<%= resume ? resume.github : '' %>"
                        >

                    </div>


                    <div class="field">

                        <label>LinkedIn</label>

                        <input
                            type="url"
                            name="linkedin"
                            placeholder="https://linkedin.com/in/username"
                            value="<%= resume ? resume.linkedin : '' %>"
                        >

                    </div>


                    <div class="field full">

                        <label>Portfolio</label>

                        <input
                            type="url"
                            name="portfolio"
                            placeholder="https://yourportfolio.com"
                            value="<%= resume ? resume.portfolio : '' %>"
                        >

                    </div>

                </div>

            </div>


            <!-- SUMMARY -->

            <div class="section">

                <h2>Professional Summary</h2>

                <div class="field">

                    <label>Summary</label>

                    <textarea
                        name="summary"
                        placeholder="Write a short professional summary..."
                    ><%= resume ? resume.summary : '' %></textarea>

                    <div class="hint">
                        Keep it around 3–5 lines.
                    </div>

                </div>

            </div>


            <!-- SKILLS -->

            <div class="section">

                <h2>Technical Skills</h2>

                <div class="field">

                    <label>Skills</label>

                    <textarea
                        name="skills"
                        placeholder="JavaScript, React, Node.js, MongoDB, SQL"
                    ><%= resume ? resume.skills : '' %></textarea>

                    <div class="hint">
                        Separate skills with commas.
                    </div>

                </div>

            </div>


            <!-- EDUCATION -->

            <div class="section">

                <h2>Education</h2>

                <div class="field">

                    <label>Education</label>

                    <textarea
                        name="education"
                        placeholder="B.Tech in Computer Science and Engineering&#10;XYZ University | 2023 - 2027"
                    ><%= resume ? resume.education : '' %></textarea>

                </div>

            </div>


            <!-- EXPERIENCE -->

            <div class="section">

                <h2>Experience & Internships</h2>

                <div class="field">

                    <label>Experience</label>

                    <textarea
                        name="experience"
                        placeholder="Software Developer Intern — XYZ Company&#10;May 2026 – July 2026&#10;• Developed REST APIs using Node.js and Express.&#10;• Worked with MongoDB."
                    ><%= resume ? resume.experience : '' %></textarea>

                </div>

            </div>


            <!-- PROJECTS -->

            <div class="section">

                <h2>Projects</h2>

                <div class="field">

                    <label>Projects</label>

                    <textarea
                        name="projects"
                        placeholder="AI Resume Builder — React, Node.js, MongoDB&#10;Developed an AI-powered resume builder..."
                    ><%= resume ? resume.projects : '' %></textarea>

                </div>

            </div>


            <!-- CERTIFICATIONS -->

            <div class="section">

                <h2>Certifications</h2>

                <div class="field">

                    <label>Certifications</label>

                    <textarea
                        name="certifications"
                        placeholder="AWS Cloud Practitioner — Amazon"
                    ><%= resume ? resume.certifications : '' %></textarea>

                </div>

            </div>


            <!-- ACHIEVEMENTS -->

            <div class="section">

                <h2>Achievements</h2>

                <div class="field">

                    <label>Achievements</label>

                    <textarea
                        name="achievements"
                        placeholder="• Solved 300+ coding problems&#10;• Participated in hackathons"
                    ><%= resume ? resume.achievements : '' %></textarea>

                </div>

            </div>


            <!-- LANGUAGES -->

            <div class="section">

                <h2>Languages</h2>

                <div class="field">

                    <label>Languages</label>

                    <input
                        type="text"
                        name="languages"
                        placeholder="English, Hindi"
                        value="<%= resume ? resume.languages : '' %>"
                    >

                </div>

            </div>


            <button
                type="submit"
                class="save-btn"
            >
                Save & Generate Resume
            </button>


        </form>

    </div>

</div>

</body>
</html>